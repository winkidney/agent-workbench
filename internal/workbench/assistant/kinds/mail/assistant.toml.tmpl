# {{.Name}}: settings Agent Workbench reads. Changes apply within a minute.
name = {{printf "%q" .Name}}
# claude or codex
agent = {{printf "%q" .Agent}}
# Every request is a new session; the inbox in state/ carries over.
sessions = "per-task"
memory = "state"

# Fetches new mail every 30 minutes and, only when there is some, hands the
# list to a background run that sorts it into state/inbox.md (ADR 0011).
[[routines]]
name = "Check mail"
every = "30m"
command = "uv run tools/fetch.py"
message = "New mail is listed below. Sort it into state/inbox.md as .agents/skills/check-mail/SKILL.md says."
background = true
# Off until config.toml and the password are in place (AGENTS.md, Setting up).
enabled = false
