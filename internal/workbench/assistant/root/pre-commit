#!/bin/sh
# agent-workbench secret check (installed by Agent Workbench; ADR 0014).
# Refuses a commit that would put credentials in the repository of
# assistants: they belong in ~/.config/assistant/secrets/ (mode 600), or in
# an existing tool's own sign-in. Only when the user has explicitly asked to
# keep a credential in this repository:  ASSISTANTS_ALLOW_SECRETS=1 git commit
[ "${ASSISTANTS_ALLOW_SECRETS:-}" = 1 ] && exit 0

names=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$names" ] && exit 0

files=""
oldifs=$IFS
IFS='
'
for f in $names; do
	case "$f" in
	*.pem | *.key | *.p12 | *.pfx | *id_rsa* | *id_ed25519* | .env | .env.* | */.env | */.env.* | *credentials*.json | *token*.json | secrets/* | */secrets/*)
		files="$files
  $f"
		;;
	esac
done
IFS=$oldifs

pattern='-----BEGIN [A-Z ]*PRIVATE KEY-----|(sk|rk)-[A-Za-z0-9_-]{32,}|gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{40,}|xox[abprs]-[A-Za-z0-9-]{10,}|(AKIA|ASIA)[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}|"refresh_token" *: *"[^"]{10,}|"client_secret" *: *"[^"]{10,}|://[^/ :@"]+:[^/ @"]{6,}@'
# File and line only: the value is never printed.
lines=$(git diff --cached --name-only -z --diff-filter=ACMR | xargs -0 git grep --cached -I -n -E -e "$pattern" -- 2>/dev/null | cut -d: -f1,2)

[ -z "$files$lines" ] && exit 0
echo "Commit refused: it would put credentials in the repository of assistants." >&2
[ -n "$files" ] && echo "Credential files:$files" >&2
[ -n "$lines" ] && echo "Lines that look like a password, token or key:" >&2 && echo "$lines" | sed 's/^/  /' >&2
echo "Keep credentials in ~/.config/assistant/secrets/ (mode 600) and name the file in config.toml." >&2
echo "Only if the user explicitly asked to keep this one here: ASSISTANTS_ALLOW_SECRETS=1 git commit ..." >&2
exit 1
